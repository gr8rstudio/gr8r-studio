{
  "name": "gr8r-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Gr8r Studio: a calm, structured project management workspace.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply gr8r-studio --local",
    "db:migrate:remote": "wrangler d1 migrations apply gr8r-studio --remote",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "lucide": "^0.460.0",
    "prettier": "^3.9.9",
    "vite": "^6.4.4",
    "wrangler": "4.148.0"
  }
}
