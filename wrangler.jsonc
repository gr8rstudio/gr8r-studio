{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gr8r-studio",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    // Only API calls run the Worker; every other request is a free static-asset hit.
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gr8r-studio",
      // Replace with the id printed by `npx wrangler d1 create gr8r-studio` (see README).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // Optional: comma list of emails and @domains allowed to sign in, e.g. "@higherdetail.com". Empty = any Google account.
    "ALLOWED_EMAILS": "",
  },
  // GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are secrets: `.dev.vars` locally, `wrangler secret put` in production.
}
