{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gr8r-studio",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Serves the app at studio.higherdetail.com (DNS record and certificate are created on deploy).
  "routes": [{ "pattern": "studio.higherdetail.com", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "not_found_handling": "single-page-application",
    // Only API calls run the Worker; every other request is a free static-asset hit.
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gr8r-studio",
      "database_id": "9acb45a9-aeec-448f-a927-8d534d93f5ba",
      "migrations_dir": "migrations",
    },
  ],
  // Uploaded files and attachments. Create once with `npx wrangler r2 bucket create gr8r-studio-files`.
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "gr8r-studio-files",
    },
    {
      "bucket_name": "gr8r-studio-files",
      "binding": "gr8r_studio_files",
    },
  ],
  "vars": {
    // Accounts that can always sign in and create workspaces: comma list of emails and @domains.
    "ALLOWED_EMAILS": "slefkaditis@gmail.com",
    // "true": everyone else needs an invite (or to already be in a workspace) to sign in.
    "INVITE_ONLY": "true",
  },
  // GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are secrets: `.dev.vars` locally, `wrangler secret put` in production.
}
